<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>AcuGIS</Company>
    <Authors>AcuGIS</Authors>
    <Copyright>Copyright (c) AcuGIS</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AcuGIS/acugis-report-server-ce</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AcuGIS/acugis-report-server-ce</PackageProjectUrl>
  </PropertyGroup>
</Project>
