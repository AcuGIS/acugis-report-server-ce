# Stand-alone AcuGIS Report Server (example)

# App + vendored shell UI
Alias /acugis-report-server /opt/acugis-report-server
Alias /shared/ui /opt/acugis-report-server/shared/ui

<Directory /opt/acugis-report-server>
    DirectoryIndex index.php
    Options FollowSymLinks -Indexes
    AllowOverride All
    Require all granted
</Directory>

<Directory /opt/acugis-report-server/shared/ui>
    Options FollowSymLinks -Indexes
    AllowOverride None
    Require all granted
</Directory>

# Jasper Tomcat (docker compose maps host 9099 -> container 8080)
ProxyPreserveHost On
ProxyPass /report http://127.0.0.1:9099/report
ProxyPassReverse /report http://127.0.0.1:9099/report
ProxyPass /acugis_report_image http://127.0.0.1:9099/acugis_report_image
ProxyPassReverse /acugis_report_image http://127.0.0.1:9099/acugis_report_image
