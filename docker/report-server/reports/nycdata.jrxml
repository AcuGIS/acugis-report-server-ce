<jasperReport name="NYC_Data" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dec1c8c9-9647-41e7-945d-e6db39192d08">
	<parameter name="p_boro" forPrompting="false" class="java.util.Collection">
		<defaultValueExpression><![CDATA[java.util.Arrays.asList("Manhattan","Bronx","Staten Island","Queens","Brooklyn")]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    id,
    borough,
    neighborhood,
    median_rent_2010,
    median_rent_2016,
    rent_increase_percent
FROM nyc_data
WHERE $X{IN, borough, p_boro}
ORDER BY borough, neighborhood]]></query>
