  <query language="SQL"><![CDATA[SELECT "u"."fid", "u"."ogc_fid", "u"."state_name", "u"."state_fips", "u"."sub_region", "u"."state_abbr", "u"."land_km", "u"."water_km", "u"."persons", "u"."families", "u"."houshold", "u"."male", "u"."female", "u"."workers", "u"."drvalone"
