<jasperReport name="nycemployment" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2b14f7fd-eee2-4d35-acd8-bef677361e08">
	<parameter name="p_boro" forPrompting="false" class="java.util.Collection">
		<defaultValueExpression><![CDATA[java.util.Arrays.asList("Manhattan","Bronx","Staten Island","Queens","Brooklyn")]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[select  nyc_employment.nta,  nyc_employment.local_jobs_2010, 
nyc_employment.borough, 
nyc_employment.boroid, 
nyc_employment.local_jobs_2015,  
nyc_employment.local_job_growth_percent
from  nyc_employment 
WHERE $X{IN, nyc_employment.borough, p_boro}
ORDER BY nyc_employment.borough, nyc_employment.nta]]></query>
	<field name="borough" class="java.lang.String"/>
	<field name="boroid" class="java.lang.Integer"/>
	<field name="nta" class="java.lang.String"/>
	<field name="local_jobs_2010" class="java.lang.Integer"/>
	<field name="local_jobs_2015" class="java.lang.Integer"/>
	<field name="local_job_growth_percent" class="java.lang.Integer"/>
