<jasperReport name="statesfinancial" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5b8cf7eb-fea5-4902-aff5-10ba4e7b97a1">
	<parameter name="p_geometry" forPrompting="false" class="java.lang.String"/>
	<parameter name="p_srid" forPrompting="false" class="java.lang.Integer"/>
	<parameter name="p_industry" forPrompting="false" class="java.util.Collection">
		<defaultValueExpression><![CDATA[java.util.Arrays.asList("Technology","Healthcare","Tourism","Manufacturing","Logistics")]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
    p.state_name,
    p.persons,
    p.families,
    p.houshold,
    e.median_income,
    e.unemployment_rate,
    e.poverty_rate,
    e.median_home_value,
    e.major_industry
FROM population p
JOIN state_economics e
    ON p.state_fips = e.state_fips
WHERE (
    $P{p_geometry} IS NULL
    OR ST_Intersects(
        p.geom,
        ST_GeomFromText($P{p_geometry}, $P{p_srid})
    )
)
AND
$X{IN, e.major_industry, p_industry}
ORDER BY p.state_name]]></query>
	<field name="state_name" class="java.lang.String"/>
	<field name="persons" class="java.lang.Double"/>
	<field name="families" class="java.lang.Double"/>
	<field name="houshold" class="java.lang.Double"/>
	<field name="median_income" class="java.lang.Integer"/>
	<field name="unemployment_rate" class="java.math.BigDecimal"/>
	<field name="poverty_rate" class="java.math.BigDecimal"/>
	<field name="median_home_value" class="java.lang.Integer"/>
	<field name="major_industry" class="java.lang.String"/>
