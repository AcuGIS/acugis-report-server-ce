[Unit]
Description=AcuGIS Report Server
After=network-online.target acugis-tomcat.service postgresql.service postgresql@*.service
Wants=network-online.target
Requires=acugis-tomcat.service

[Service]
Type=simple
User=www-data
Group=www-data
# tomcat group: write JNDI context.xml / connection properties under /opt/tomcat/conf
# (directory is 1770 tomcat:tomcat with sticky bit; files are www-data:tomcat 0640).
SupplementaryGroups=tomcat
EnvironmentFile=-/etc/acugis-report-server/env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
WorkingDirectory=/opt/acugis-report-server
ExecStart=/opt/acugis-report-server/bin/jrs-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
