# AcuGIS Report Server — native install environment
# Copied to /etc/acugis-report-server/env on first install (not overwritten on upgrade).
# All values can also be supplied as process environment variables for unattended install.

JRS_ENVIRONMENT=production
JRS_APP_VERSION=1.0.0
JRS_LISTEN_ADDR=127.0.0.1:9088
JRS_BASE_PATH=/
JRS_JASPER_HOME=/opt/acugis-report-server

# Application PostgreSQL
JRS_DB_HOST=localhost
JRS_DB_PORT=5432
JRS_DB_NAME=jasper_reports
JRS_DB_USER=jasper
JRS_DB_PASS=
JRS_DB_SCHEMA=public
JRS_DB_SSLMODE=disable

# Jasper / Tomcat (internal only — do not publish :8080)
CATALINA_HOME=/opt/tomcat
CATALINA_BASE=/opt/tomcat
JRS_JRXML_DIR=/opt/tomcat/acugis/reports
JRS_JASPER_CONTEXT_PATH=/opt/tomcat/conf/context.xml
JRS_JASPER_REPORTS_CONTAINER_DIR=/opt/tomcat/acugis/reports
JRS_RESOURCE_PATHS_DIR=/opt/tomcat/acugis/resource-paths
JRS_GEOSERVER_CONNECTIONS_PATH=/opt/tomcat/conf/geoserver-connections.properties
JRS_JASPER_INTERNAL_REPORT_URL=http://127.0.0.1:8080/report
JRS_JASPER_INTERNAL_IMAGE_URL=http://127.0.0.1:8080/acugis_report_image
JRS_REPORTS_OWNER=tomcat
JRS_REPORTS_GROUP=tomcat

# Dynamic jrs-schedule-* timers: jrs-server (www-data) uses sudo -n for ln/rm/systemctl.
# The installer writes /etc/sudoers.d/acugis-report-server. Do not chmod /etc/systemd/system.
JRS_JASPER_SYSTEMD_USE_SUDO=true

# Compile-time edition is the installed package (OSS omits Professional modules).
# ACUGIS_EDITION does not grant Professional features. Activate
# report-server-professional in Administration → License.
# ACUGIS_LICENSE_STATE_DIR=/var/lib/acugis-report-server

# Initial admin (installer only; not required at runtime)
# JRS_ADMIN_USER=admin
# JRS_ADMIN_PASSWORD=

# Optional SMTP for scheduled email
# JRS_SMTP_HOST=
# JRS_SMTP_PORT=587
# JRS_SMTP_USER=
# JRS_SMTP_PASS=
# JRS_SMTP_FROM=reports@example.com

# Embedded Analytics signing key. A fresh install generates a 32-byte hex
# secret locally when this is unset. Upgrades keep an existing value, and an
# administrator-supplied ACUGIS_EMBED_TOKEN_SECRET or JRS_EMBED_TOKEN_SECRET
# is kept. The installer does not print the secret.
# ACUGIS_EMBED_TOKEN_SECRET=
# ACUGIS_EMBED_ALLOWED_ORIGINS=
