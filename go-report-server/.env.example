# Copy to .env for local Go development. Do not put real production secrets here.
# Variable names match the existing PHP application (config.php / lib/auth.php).

# HTTP (Go-only; PHP continues to use Apache)
JRS_LISTEN_ADDR=127.0.0.1:9088
# Public URL prefix (must match the reverse-proxy path). Example: /go for https://host/go/
JRS_BASE_PATH=/
# JRS_BASE_PATH=/go
JRS_ENVIRONMENT=development
JRS_APP_VERSION=1.0.0

# Product edition: community (default) | professional
# ACUGIS_EDITION is not a license. Professional features require a verified
# report-server-professional ACL1 token (Administration → License).
# ACUGIS_LICENSE_STATE_DIR=/var/lib/acugis-report-server

# PHP install root (required if not auto-detected as the parent of go-report-server)
# JRS_JASPER_HOME=/opt/acugis-report-server

# PostgreSQL (same variables as PHP)
JRS_DB_HOST=localhost
JRS_DB_PORT=5432
JRS_DB_NAME=jasper_reports
JRS_DB_USER=postgres
JRS_DB_PASS=
JRS_DB_SCHEMA=public
JRS_DB_SSLMODE=disable
JRS_DB_CONNECT_TIMEOUT=5s

# Internal Jasper/Tomcat endpoints (never expose publicly). Go proxies execute here.
# 503 "jasper engine unavailable" means this host:port is down or unreachable from the Go process.
JRS_JASPER_INTERNAL_REPORT_URL=http://127.0.0.1:9099/report
JRS_JASPER_INTERNAL_IMAGE_URL=http://127.0.0.1:9099/acugis_report_image
JRS_JASPER_TIMEOUT=600s

# Viewer execute URL. The name execute_report.php is a Go compatibility alias
# (routes to handleDevReport) — it does not invoke PHP.
# JRS_REPORT_ENDPOINT=/acugis-report-server/reports/execute_report.php
JRS_REPORT_ENDPOINT=execute_report.php

# Optional path overrides (defaults derive from JRS_JASPER_HOME / install root)
#
# Standalone Tomcat 10: point these at CATALINA_BASE (required if CATALINA_BASE/HOME is unset).
# Upload, map edit, compile, and datasource context.xml all use these paths — not docker/report-server.
#   JRS_JRXML_DIR=C:\Tomcat\acugis\reports
#   JRS_JASPER_CONTEXT_PATH=C:\Tomcat\conf\context.xml
#   JRS_JASPER_REPORTS_CONTAINER_DIR=C:\Tomcat\acugis\reports
#
# Or set CATALINA_BASE / CATALINA_HOME and leave the above unset; Go prefers
#   $CATALINA_BASE/acugis/reports and $CATALINA_BASE/conf/context.xml when those exist.
#
# Docker Tomcat 9 (legacy defaults when CATALINA_* / overrides are absent):
#   JRXML → {JRS_JASPER_HOME}/docker/report-server/reports
#   context.xml → {JRS_JASPER_HOME}/docker/report-server/context.xml
#   container map path → /usr/local/tomcat/jasper_reports/reports
#
# JRS_JRXML_DIR=
# JRS_JASPER_CONTEXT_PATH=
# JRS_JASPER_SCHEDULE_DIR=
# JRS_JASPER_EMAIL_TMPL_DIR=
# Only set when Tomcat sees a DIFFERENT path than JRS_JRXML_DIR (Docker bind mounts).
# Standalone: leave unset — P_MAP_IMAGE uses the absolute JRXML dir path.
# JRS_JASPER_REPORTS_CONTAINER_DIR=/usr/local/tomcat/jasper_reports/reports
# chown JRXML / map cache writes to the Tomcat OS user (needed when Go runs as root)
JRS_REPORTS_OWNER=tomcat
JRS_REPORTS_GROUP=tomcat

# Auth
JRS_AUTH_DISABLED=0
# JRS_SESSION_COOKIE=jrs_session
# Local-only for cmd/jrs-auth-check (prefer stdin; never commit real tokens)
# JRS_AUTH_CHECK_TOKEN=

# Optional OIDC SSO (disabled by default; requires Professional / enterprise.sso.oidc).
# Env overrides Administration → Authentication DB settings when set.
# See docs/oidc.md
# ACUGIS_LOCAL_AUTH_ENABLED=true
# ACUGIS_OIDC_ENABLED=false
# ACUGIS_OIDC_ISSUER=https://idp.example.com/realms/company
# ACUGIS_OIDC_CLIENT_ID=
# ACUGIS_OIDC_CLIENT_SECRET=
# ACUGIS_OIDC_SCOPES=openid profile email
# ACUGIS_OIDC_USERNAME_CLAIM=preferred_username
# ACUGIS_OIDC_EMAIL_CLAIM=email
# ACUGIS_OIDC_NAME_CLAIM=name
# ACUGIS_OIDC_PROVIDER_NAME=Company SSO

# Optional SAML 2.0 SSO (disabled by default; requires Professional / enterprise.sso.saml).
# Env overrides Administration → Authentication DB settings when set.
# Prefer ACUGIS_SAML_SP_KEY_FILE / ACUGIS_SAML_SP_CERT_FILE for SP private key mounts.
# See docs/saml.md
# ACUGIS_SAML_ENABLED=false
# ACUGIS_SAML_PROVIDER_NAME=Corporate SSO
# ACUGIS_SAML_IDP_METADATA_URL=https://idp.example.com/metadata
# ACUGIS_SAML_IDP_ENTITY_ID=
# ACUGIS_SAML_IDP_SSO_URL=
# ACUGIS_SAML_SP_ENTITY_ID=
# ACUGIS_SAML_ACS_URL=
# ACUGIS_SAML_NAMEID_ATTRIBUTE=NameID
# ACUGIS_SAML_USERNAME_ATTRIBUTE=
# ACUGIS_SAML_EMAIL_ATTRIBUTE=email
# ACUGIS_SAML_DISPLAY_NAME_ATTRIBUTE=displayName
# ACUGIS_SAML_CLOCK_SKEW=120
# ACUGIS_SAML_SP_KEY_FILE=
# ACUGIS_SAML_SP_CERT_FILE=

# SMTP for scheduled report email (same vars as PHP config.php).
# When JRS_SMTP_HOST is empty, Go falls back to local sendmail (PHP mail() parity).
# JRS_SMTP_HOST=smtp.example.com
# JRS_SMTP_PORT=587
# JRS_SMTP_USER=
# JRS_SMTP_PASS=
# JRS_SMTP_FROM=reports@example.com
# EHLO/HELO name (optional). Defaults to domain of JRS_SMTP_FROM; providers often reject "localhost".
# JRS_SMTP_HELO=example.com
# JRS_SENDMAIL_PATH=/usr/sbin/sendmail

# Professional MCP (Streamable HTTP). Off unless set to 1/true/yes/on.
# OSS builds do not mount this endpoint. Community edition returns 403 when it is on.
# JRS_MCP_ENABLED=false
# Public hostnames for a reverse proxy that preserves Host. Loopback Host values
# are always accepted on the loopback listener. Example: reports.example.com
# JRS_MCP_ALLOWED_HOSTS=

# Auditing (append-only trail in PostgreSQL audit_log)
# JRS_AUDIT_ENABLED=true
# JRS_AUDIT_RETENTION_DAYS=90
# JRS_AUDIT_LOG_PARAMETERS=true
# JRS_AUDIT_LOG_SQL=false
# Aliases also accepted: AUDIT_ENABLED, AUDIT_RETENTION_DAYS, AUDIT_LOG_PARAMETERS, AUDIT_LOG_SQL

# JavaScript Embedding SDK (browser embeds require short-lived emb_ tokens)
# Comma-separated origins allowed to frame /embed/* and call /api/v1/embed/*
# ACUGIS_EMBED_ALLOWED_ORIGINS=https://app.example.com,https://portal.example.com
# In development, localhost origins are added when unset.
# Required in production — signs emb_ tokens minted by POST /api/v1/embed/token
# ACUGIS_EMBED_TOKEN_SECRET=change-me-to-a-long-random-string
# ACUGIS_EMBED_TOKEN_TTL=15m
# Aliases: JRS_EMBED_ALLOWED_ORIGINS, JRS_EMBED_TOKEN_SECRET, JRS_EMBED_TOKEN_TTL
